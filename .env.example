# Public browser configuration only.
# Never place service-role keys, passwords, private tokens, or other secrets here.

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-or-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Optional OpenTelemetry-compatible endpoint.
# Leave empty to disable telemetry export.
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
VITE_OTEL_SERVICE_NAME=finanzzi-web
